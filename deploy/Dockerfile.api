FROM python:3.12-slim-bookworm AS builder
WORKDIR /build
COPY pyproject.toml requirements-dev.lock.txt ./
COPY backend/ ./backend/
RUN apt-get update && apt-get install -y --no-install-recommends g++ \
    && rm -rf /var/lib/apt/lists/* \
    && python -m backend.simulator.tep.build --output /opt/tep
RUN pip wheel --no-cache-dir --wheel-dir /wheels -c requirements-dev.lock.txt .

FROM python:3.12-slim-bookworm AS runtime
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    IRON_MAN_DB_PATH=/data/ironman.sqlite3 \
    IRON_MAN_TEP_ENGINE_DIR=/opt/tep \
    IRON_MAN_TEP_RUN_DIR=/data/tep-runs \
    IRON_MAN_TEP_CONTRACT_PATH=/app/contracts/tep-model.json \
    IRON_MAN_TEP_EVIDENCE_SOURCE_PATH=/app/data/sources/paper-sources.json \
    IRON_MAN_EVIDENCE_SOURCE_PATH=/app/data/sources/cooling-demo.json
RUN apt-get update && apt-get install -y --no-install-recommends libstdc++6 coreutils \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --gid 10001 app \
    && useradd --uid 10001 --gid app --no-create-home app \
    && mkdir /data && chown app:app /data
WORKDIR /app
COPY --from=builder /wheels /wheels
COPY --from=builder /opt/tep /opt/tep
RUN pip install --no-cache-dir --no-index --find-links=/wheels iron-man-gateway \
    && rm -rf /wheels
COPY fixtures/ ./fixtures/
COPY data/sources/ /app/data/sources/
COPY contracts/tep-model.json /app/contracts/tep-model.json
ENV IRON_MAN_EVIDENCE_SOURCE_PATH=/app/data/sources/cooling-demo.json
USER app
EXPOSE 8000
CMD ["python", "-m", "uvicorn", "backend.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1"]
