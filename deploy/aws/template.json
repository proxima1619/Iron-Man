{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Iron Man hackathon demo: one Ubuntu t3.medium, 30GB encrypted gp3, one static IPv4; no IAM role, load balancer or NAT gateway. Deleting this stack deletes the server disk.",
  "Parameters": {
    "AdminCidr": {
      "Type": "String",
      "Description": "Only this administrator IPv4 /32 may connect with SSH",
      "AllowedPattern": "(?:[0-9]{1,3}\\.){3}[0-9]{1,3}/32"
    },
    "SshPublicKey": {
      "Type": "String",
      "Description": "Only the public key; never paste a private key",
      "AllowedPattern": "ssh-ed25519 [A-Za-z0-9+/=]+(?: [^\\r\\n]+)?"
    },
    "UbuntuAmi": {
      "Type": "AWS::SSM::Parameter::Value<AWS::EC2::Image::Id>",
      "Default": "/aws/service/canonical/ubuntu/server/24.04/stable/current/amd64/hvm/ebs-gp3/ami-id"
    }
  },
  "Resources": {
    "Vpc": {
      "Type": "AWS::EC2::VPC",
      "Properties": {
        "CidrBlock": "10.81.0.0/16",
        "EnableDnsSupport": true,
        "EnableDnsHostnames": true,
        "Tags": [
          {
            "Key": "Name",
            "Value": {
              "Fn::Sub": "${AWS::StackName}"
            }
          }
        ]
      }
    },
    "InternetGateway": {
      "Type": "AWS::EC2::InternetGateway"
    },
    "GatewayAttachment": {
      "Type": "AWS::EC2::VPCGatewayAttachment",
      "Properties": {
        "VpcId": {
          "Ref": "Vpc"
        },
        "InternetGatewayId": {
          "Ref": "InternetGateway"
        }
      }
    },
    "Subnet": {
      "Type": "AWS::EC2::Subnet",
      "Properties": {
        "VpcId": {
          "Ref": "Vpc"
        },
        "CidrBlock": "10.81.1.0/24",
        "MapPublicIpOnLaunch": true
      }
    },
    "RouteTable": {
      "Type": "AWS::EC2::RouteTable",
      "Properties": {
        "VpcId": {
          "Ref": "Vpc"
        }
      }
    },
    "InternetRoute": {
      "Type": "AWS::EC2::Route",
      "DependsOn": "GatewayAttachment",
      "Properties": {
        "RouteTableId": {
          "Ref": "RouteTable"
        },
        "DestinationCidrBlock": "0.0.0.0/0",
        "GatewayId": {
          "Ref": "InternetGateway"
        }
      }
    },
    "RouteAssociation": {
      "Type": "AWS::EC2::SubnetRouteTableAssociation",
      "Properties": {
        "SubnetId": {
          "Ref": "Subnet"
        },
        "RouteTableId": {
          "Ref": "RouteTable"
        }
      }
    },
    "SecurityGroup": {
      "Type": "AWS::EC2::SecurityGroup",
      "Properties": {
        "GroupDescription": "Iron Man demo HTTPS and restricted administrator SSH",
        "VpcId": {
          "Ref": "Vpc"
        },
        "SecurityGroupIngress": [
          {
            "IpProtocol": "tcp",
            "FromPort": 80,
            "ToPort": 80,
            "CidrIp": "0.0.0.0/0"
          },
          {
            "IpProtocol": "tcp",
            "FromPort": 443,
            "ToPort": 443,
            "CidrIp": "0.0.0.0/0"
          },
          {
            "IpProtocol": "tcp",
            "FromPort": 22,
            "ToPort": 22,
            "CidrIp": {
              "Ref": "AdminCidr"
            }
          }
        ]
      }
    },
    "SshKey": {
      "Type": "AWS::EC2::KeyPair",
      "Properties": {
        "KeyName": {
          "Fn::Sub": "${AWS::StackName}-ssh"
        },
        "PublicKeyMaterial": {
          "Ref": "SshPublicKey"
        }
      }
    },
    "Server": {
      "Type": "AWS::EC2::Instance",
      "DependsOn": [
        "InternetRoute",
        "RouteAssociation"
      ],
      "Properties": {
        "ImageId": {
          "Ref": "UbuntuAmi"
        },
        "InstanceType": "t3.medium",
        "KeyName": {
          "Ref": "SshKey"
        },
        "SubnetId": {
          "Ref": "Subnet"
        },
        "SecurityGroupIds": [
          {
            "Ref": "SecurityGroup"
          }
        ],
        "CreditSpecification": {
          "CPUCredits": "standard"
        },
        "MetadataOptions": {
          "HttpTokens": "required",
          "HttpEndpoint": "enabled",
          "HttpPutResponseHopLimit": 1
        },
        "BlockDeviceMappings": [
          {
            "DeviceName": "/dev/sda1",
            "Ebs": {
              "VolumeSize": 30,
              "VolumeType": "gp3",
              "Encrypted": true,
              "DeleteOnTermination": true
            }
          }
        ],
        "UserData": {
          "Fn::Base64": "#!/bin/bash\nset -euo pipefail\nexport DEBIAN_FRONTEND=noninteractive\napt-get -o Acquire::Retries=10 update\napt-get -o Acquire::Retries=10 install -y ca-certificates curl git python3\ninstall -m 0755 -d /etc/apt/keyrings\ncurl --fail --silent --show-error --retry 10 --retry-delay 5 https://download.docker.com/linux/ubuntu/gpg -o /etc/apt/keyrings/docker.asc\nchmod a+r /etc/apt/keyrings/docker.asc\n. /etc/os-release\ncat > /etc/apt/sources.list.d/docker.sources <<EOF\nTypes: deb\nURIs: https://download.docker.com/linux/ubuntu\nSuites: ${UBUNTU_CODENAME:-$VERSION_CODENAME}\nComponents: stable\nArchitectures: $(dpkg --print-architecture)\nSigned-By: /etc/apt/keyrings/docker.asc\nEOF\napt-get -o Acquire::Retries=10 update\napt-get -o Acquire::Retries=10 install -y docker-ce docker-ce-cli containerd.io docker-buildx-plugin docker-compose-plugin\nsystemctl enable --now docker\nusermod -aG docker ubuntu\ninstall -d -o ubuntu -g ubuntu -m 0750 /opt/iron-man\n# No app or secret is deployed by cloud-init. SSH deployment follows separately.\n"
        },
        "Tags": [
          {
            "Key": "Name",
            "Value": {
              "Fn::Sub": "${AWS::StackName}"
            }
          },
          {
            "Key": "Project",
            "Value": "Iron-Man-Demo"
          }
        ]
      }
    },
    "PublicIp": {
      "Type": "AWS::EC2::EIP",
      "DependsOn": "GatewayAttachment",
      "Properties": {
        "Domain": "vpc"
      }
    },
    "IpAssociation": {
      "Type": "AWS::EC2::EIPAssociation",
      "Properties": {
        "AllocationId": {
          "Fn::GetAtt": [
            "PublicIp",
            "AllocationId"
          ]
        },
        "InstanceId": {
          "Ref": "Server"
        }
      }
    }
  },
  "Outputs": {
    "InstanceId": {
      "Value": {
        "Ref": "Server"
      }
    },
    "PublicIp": {
      "Value": {
        "Ref": "PublicIp"
      }
    },
    "SuggestedDemoHost": {
      "Value": {
        "Fn::Sub": "${PublicIp}.sslip.io"
      }
    },
    "SshUser": {
      "Value": "ubuntu"
    }
  }
}
