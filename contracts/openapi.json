  "components": {
    "schemas": {
      "AppliedExecution": {
        "properties": {
          "execution_id": {
            "type": "string",
            "title": "Execution Id"
          },
          "status": {
            "type": "string",
            "const": "applied",
            "title": "Status"
          },
          "virtual": {
            "type": "boolean",
            "const": true,
            "title": "Virtual"
          },
          "command": {
            "$ref": "#/components/schemas/Command-Output"
          },
          "state": {
            "$ref": "#/components/schemas/Snapshot"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "execution_id",
          "status",
          "virtual",
          "command",
          "state"
        ],
        "title": "AppliedExecution"
      },
      "Approval": {
        "properties": {
          "actor": {
            "type": "string",
            "title": "Actor"
          },
          "report_digest": {
            "type": "string",
            "title": "Report Digest"
          },
          "expires_at": {
            "type": "number",
            "title": "Expires At"
          },
          "reason": {
            "type": "string",
            "title": "Reason"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "actor",
          "report_digest",
          "expires_at",
          "reason"
        ],
        "title": "Approval"
      },
      "AuditEvent": {
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "created",
              "evaluation_failed",
              "evaluated",
              "approve",
              "reject",
              "execution_denied",
              "execution_reserved",
              "executed",
              "execution_unknown",
              "evaluation_interrupted",
              "execution_interrupted",
              "evaluation_started"
            ],
            "title": "Kind"
          },
          "at": {
            "type": "number",
            "title": "At"
          },
          "verdict": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "draft",
                  "evaluating",
                  "blocked",
                  "hold",
                  "awaiting_approval",
                  "approved",
                  "rejected",
                  "revalidation_required",
                  "executing",
                  "completed",
                  "execution_unknown"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Verdict"
          },
          "report_digest": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Report Digest"
          },
          "actor": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Actor"
          },
          "reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reason"
          },
          "execution_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Execution Id"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "kind",
          "at",
          "verdict",
          "report_digest",
          "actor",
          "reason",
          "execution_id"
        ],
        "title": "AuditEvent"
      },
      "Command-Input": {
        "properties": {
          "type": {
            "type": "string",
            "const": "set_pump_speed",
            "title": "Type",
            "default": "set_pump_speed"
          },
          "target_pct": {
            "type": "number",
            "maximum": 100.0,
            "minimum": 0.0,
            "title": "Target Pct"
          },
          "duration_s": {
            "type": "integer",
            "maximum": 3600.0,
            "minimum": 1.0,
            "title": "Duration S",
            "default": 300
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "target_pct"
        ],
        "title": "Command"
      },
      "Command-Output": {
        "properties": {
          "type": {
            "type": "string",
            "const": "set_pump_speed",
            "title": "Type",
            "default": "set_pump_speed"
          },
          "target_pct": {
            "type": "number",
            "maximum": 100.0,
            "minimum": 0.0,
            "title": "Target Pct"
          },
          "duration_s": {
            "type": "integer",
            "maximum": 3600.0,
            "minimum": 1.0,
            "title": "Duration S",
            "default": 300
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "type",
          "target_pct",
          "duration_s"
        ],
        "title": "Command"
      },
      "DecisionInput": {
        "properties": {
          "report_digest": {
            "type": "string",
            "title": "Report Digest"
          },
          "decision": {
            "type": "string",
            "enum": [
              "approve",
              "reject"
            ],
            "title": "Decision"
          },
          "reason": {
            "type": "string",
            "maxLength": 500,
            "minLength": 1,
            "title": "Reason"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "report_digest",
          "decision",
          "reason"
        ],
        "title": "DecisionInput"
      },
      "DecisionReport": {
        "properties": {
          "schema_version": {
            "type": "string",
            "const": "1.0",
            "title": "Schema Version",
            "default": "1.0"
          },
          "revision": {
            "type": "integer",
            "title": "Revision"
          },
          "command_digest": {
            "type": "string",
            "title": "Command Digest"
          },
          "snapshot": {
            "$ref": "#/components/schemas/Snapshot"
          },
          "snapshot_digest": {
            "type": "string",
            "title": "Snapshot Digest"
          },
          "model_version": {
            "type": "string",
            "title": "Model Version"
          },
          "policy_version": {
            "type": "string",
            "title": "Policy Version"
          },
          "mock": {
            "type": "boolean",
            "title": "Mock"
          },
          "can_approve": {
            "type": "boolean",
            "title": "Can Approve"
          },
          "evidence": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/EvidenceReview"
              },
              {
                "type": "null"
              }
            ]
          },
          "simulation": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/SimulationResult"
              },
              {
                "type": "null"
              }
            ]
          },
          "verdict": {
            "type": "string",
            "enum": [
              "blocked",
              "hold",
              "awaiting_approval"
            ],
            "title": "Verdict"
          },
          "reason_code": {
            "type": "string",
            "enum": [
              "INVALID_STATE",
              "POLICY_VIOLATION",
              "LIMIT_EXCEEDED",
              "DEMO_PASS",
              "EVIDENCE_INCOMPLETE",
              "SIMULATION_INCOMPLETE",
              "MODULE_FAILURE",
              "LIVE_POLICY_NOT_CONFIGURED",
              "EVALUATION_CONTEXT_CHANGED",
              "EVALUATION_TIMEOUT",
              "EVALUATION_CANCELLED",
              "WORKER_FAILURE"
            ],
            "title": "Reason Code"
          },
          "reason": {
            "type": "string",
            "title": "Reason"
          },
          "digest": {
            "type": "string",
            "title": "Digest"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "schema_version",
          "revision",
          "command_digest",
          "snapshot",
          "snapshot_digest",
          "model_version",
          "policy_version",
          "mock",
          "can_approve",
          "evidence",
          "simulation",
          "verdict",
          "reason_code",
          "reason",
          "digest"
        ],
        "title": "DecisionReport"
      },
      "DemoStateInput": {
        "properties": {
          "load_ratio": {
            "type": "number",
            "maximum": 2.0,
            "minimum": 0.0,
            "title": "Load Ratio"
          },
          "sensor_quality": {
            "type": "string",
            "enum": [
