# Copy this file to .env in the repository root. Never commit .env.
# Local startup: python scripts/start_api.py (loads .env explicitly).
# One KEY=value per line. Quotes are optional; inline comments are not supported.
# Existing shell environment variables take precedence over this file.

# 3번: 실제 논문 검토. 사용 가능한 모델 ID와 본인의 API 키를 입력하세요.
OPENAI_API_KEY=
IRON_MAN_EVIDENCE_MODEL=
IRON_MAN_EVIDENCE_MODE=live
IRON_MAN_EVIDENCE_SOURCE_MODE=local
IRON_MAN_EVIDENCE_SOURCE_PATH=data/sources/paper-sources.json
IRON_MAN_EVIDENCE_TIMEOUT_S=20

# 실시간 검색은 SOURCE_MODE=europepmc. API 없이 모의 데모는 EVIDENCE_MODE=fixture.
# IRON_MAN_EVIDENCE_QUERY=("heat exchanger" AND fouling) OR (pump AND "variable speed" AND energy)
# 외부 논문 결과는 서버 정책에 따라 보류될 수 있습니다. 승인 우회 설정이 아닙니다.

# 로컬 합성 설비 토큰. 이메일 신원 인증이나 운영 인증이 아닙니다.
IRON_MAN_DEPLOYMENT=local
IRON_MAN_OPERATOR_TOKEN=local-operator
IRON_MAN_APPROVER_TOKEN=local-approver
IRON_MAN_APPROVER_LABEL=local-approver

# SQLite. 같은 DB는 서버 1개/worker 1개로 실행합니다.
IRON_MAN_DB_PATH=data/ironman.sqlite3
IRON_MAN_EVALUATION_WORKERS=2
IRON_MAN_EVALUATION_TIMEOUT_S=90

# 편차 기준은 팀이 합의한 경우에만 입력합니다. 빈 값은 미설정입니다.
IRON_MAN_NEGLIGIBLE_DELTA_C=

# 이메일은 연락용 알림입니다. 미설정 시 발송하지 않습니다.
IRON_MAN_APPROVER_EMAIL=
IRON_MAN_SMTP_HOST=
IRON_MAN_SMTP_PORT=587
IRON_MAN_SMTP_FROM=
IRON_MAN_SMTP_USER=
IRON_MAN_SMTP_PASSWORD=

# Docker 웹 포트. Python 실행 서버는 127.0.0.1:8000입니다.
IRON_MAN_BIND_HOST=127.0.0.1
IRON_MAN_HTTP_PORT=8080

# Separate evaluation processes; no unbounded queue.
# External TEP engine: build explicitly with python -m backend.simulator.tep.build.
# Native Linux: GNU g++ and timeout. Windows: existing Ubuntu WSL distribution.
# IRON_MAN_TEP_ENGINE_DIR=C:\path\to\Iron-Man\.tep-cache\engine
# IRON_MAN_TEP_RUN_DIR=C:\path\to\Iron-Man\.tep-cache\runs
# IRON_MAN_TEP_WSL_DISTRO=Ubuntu
# Optional prerecorded simulation reference files (not needed by the external engine).
# Default: <repository>/archive/TEP_data. Set an absolute path when installed as a package.
# IRON_MAN_TEP_REFERENCE_DIR=C:\path\to\Iron-Man\archive\TEP_data
# fixture preserves the original team demo; live requires both settings below.
# Local shell: set an absolute file path. Docker: use /app/data/sources/paper-sources.json.
# IRON_MAN_EVIDENCE_SOURCE_PATH=data/sources/paper-sources.json
# Optional search keywords when SOURCE_MODE=europepmc.
# IRON_MAN_EVIDENCE_QUERY="heat exchanger" AND fouling
# TEP uses a separate paper collection; cooling-demo documents are not reused.
# Local: absolute path. Docker default: /app/data/sources/paper-sources.json.
# IRON_MAN_TEP_EVIDENCE_SOURCE_PATH=data/sources/paper-sources.json
# IRON_MAN_TEP_EVIDENCE_QUERY="Tennessee Eastman" OR (reactor AND cooling)
